diff --git a/apps/desktop/src/app/right-sidebar/cron-tab.tsx b/apps/desktop/src/app/right-sidebar/cron-tab.tsx
new file mode 100644
index 0000000000..7225529acf
--- /dev/null
+++ b/apps/desktop/src/app/right-sidebar/cron-tab.tsx
@@ -0,0 +1,186 @@
+import { createCronTriggerController, type CronTriggerController } from '@hermes/shared'
+import { useStore } from '@nanostores/react'
+import { useEffect, useRef, useState } from 'react'
+import { useNavigate } from 'react-router'
+
+import { refreshCronJobs, triggerAndRefreshCronJobs } from '@/app/cron/cron-actions'
+import { jobTitle } from '@/app/cron/job-state'
+import { openSession } from '@/app/open-session'
+import { CRON_ROUTE } from '@/app/routes'
+import { usePaneVisible } from '@/components/pane-shell/pane-visibility'
+import { useI18n } from '@/i18n'
+import { $cronJobs, setCronFocusJobId } from '@/store/cron'
+import { $profileScope, ALL_PROFILES } from '@/store/profile'
+import { forgetSessionOwnerHintsForSession, requestSessionResume } from '@/store/session'
+
+import { CronJobSidebarRow, nextRunMs } from '../chat/sidebar/cron-jobs-section'
+import { SidebarPanelLabel } from '../shell/sidebar-label'
+
+import { RightSidebarSectionHeader } from './index'
+
+// The cron tab of the right sidebar: the same job rows the left sidebar's
+// "Cron jobs" section renders (shared component, shared $cronJobs atom), but
+// full-height in the file-browser rail so scheduled work is glanceable next to
+// the workspace tree. Rows keep their peek/trigger/pause/delete affordances;
+// management opens the full Cron page.
+export function CronPane() {
+  const { t } = useI18n()
+  const c = t.cron
+  const navigate = useNavigate()
+  const jobs = useStore($cronJobs)
+  const profileScope = useStore($profileScope)
+  const visible = usePaneVisible()
+
+  const [nowMs, setNowMs] = useState(() => Date.now())
+  const [peekJobId, setPeekJobId] = useState<null | string>(null)
+  const [triggeringJobIds, setTriggeringJobIds] = useState<ReadonlySet<string>>(() => new Set())
+  const triggerControllerRef = useRef<CronTriggerController | null>(null)
+
+  // The pane may mount before the app-wide cron poll lands its first payload;
+  // fetch once if the shared atom is still empty (silent — errors surface via
+  // the background sync path the left section rides).
+  useEffect(() => {
+    if ($cronJobs.get().length > 0) {
+      return
+    }
+
+    const scope = profileScope === ALL_PROFILES ? 'all' : profileScope
+    void refreshCronJobs(scope).catch(() => undefined)
+  }, [profileScope])
+
+  // eslint-disable-next-line no-restricted-syntax -- controller mount identity, not an atom mirror
+  useEffect(() => {
+    const controller = createCronTriggerController((jobId, running) => {
+      if (triggerControllerRef.current !== controller) {
+        return
+      }
+
+      setTriggeringJobIds(current => {
+        const next = new Set(current)
+
+        if (running) {
+          next.add(jobId)
+        } else {
+          next.delete(jobId)
+        }
+
+        return next
+      })
+    })
+
+    triggerControllerRef.current = controller
+
+    return () => {
+      triggerControllerRef.current = null
+    }
+  }, [])
+
+  // One clock for the list (rows are pure) — countdowns tick without a full
+  // re-render of the pane. Runs only while this tab is the visible pane.
+  useEffect(() => {
+    if (!visible) {
+      return
+    }
+
+    const id = window.setInterval(() => setNowMs(Date.now()), 1000)
+
+    return () => window.clearInterval(id)
+  }, [visible])
+
+  // Same next-run-first ordering the left sidebar section uses.
+  const sorted = [...jobs].sort((a, b) => {
+    const an = nextRunMs(a)
+    const bn = nextRunMs(b)
+
+    if (an !== null && bn !== null && an !== bn) {
+      return an - bn
+    }
+
+    if (an === null && bn !== null) {
+      return 1
+    }
+
+    if (an !== null && bn === null) {
+      return -1
+    }
+
+    return jobTitle(a).localeCompare(jobTitle(b))
+  })
+
+  const triggerJob = (jobId: string) => {
+    const controller = triggerControllerRef.current
+
+    if (!controller) {
+      return
+    }
+
+    const scope = profileScope === ALL_PROFILES ? 'all' : profileScope
+    void controller.run(jobId, () => triggerAndRefreshCronJobs(jobId, scope)).catch(() => undefined)
+  }
+
+  const openRun = (sessionId: string) => {
+    forgetSessionOwnerHintsForSession(sessionId)
+    requestSessionResume(sessionId)
+    openSession(sessionId, navigate)
+  }
+
+  const manageJob = (jobId: string) => {
+    setCronFocusJobId(jobId)
+    navigate(CRON_ROUTE)
+  }
+
+  return (
+    <aside
+      aria-label={c.title}
+      className="relative flex h-full w-full min-w-0 flex-col overflow-hidden border-(--ui-stroke-secondary) bg-(--ui-sidebar-surface-background) pt-(--titlebar-height) text-(--ui-text-tertiary)"
+    >
+      <RightSidebarSectionHeader>
+        <div className="flex min-w-0 flex-1 items-baseline gap-1.5">
+          <SidebarPanelLabel>{c.title}</SidebarPanelLabel>
+          {jobs.length > 0 && <span className="text-[0.6875rem] text-(--ui-text-quaternary)">{c.count(jobs.length)}</span>}
+        </div>
+      </RightSidebarSectionHeader>
+
+      {sorted.length === 0 ? (
+        <div className="flex flex-1 flex-col items-start gap-2 px-3 pb-3 pt-1 text-[0.75rem] text-(--ui-text-tertiary)">
+          <span>{c.emptyTitleNew}</span>
+          <button
+            aria-label={c.title}
+            className="rounded-md text-(--ui-text-secondary) underline-offset-2 hover:text-foreground hover:underline"
+            onClick={() => navigate(CRON_ROUTE)}
+            type="button"
+          >
+            {c.manage}
+          </button>
+        </div>
+      ) : (
+        <div className="scrollbar-fade flex min-h-0 flex-1 flex-col gap-px overflow-x-hidden overflow-y-auto overscroll-contain px-0.5 pb-1.75">
+          {sorted.map(job => (
+            <CronJobSidebarRow
+              busy={triggeringJobIds.has(job.id)}
+              expanded={peekJobId === job.id}
+              job={job}
+              key={job.id}
+              nowMs={nowMs}
+              onManage={() => manageJob(job.id)}
+              onOpenRun={openRun}
+              onTogglePeek={() => setPeekJobId(prev => (prev === job.id ? null : job.id))}
+              onTrigger={() => triggerJob(job.id)}
+            />
+          ))}
+        </div>
+      )}
+    </aside>
+  )
+}
+
+export const CRON_PANE_ZONE_CONTENT =
+  'h-full [&>aside]:h-full [&>aside]:w-full [&>aside]:pt-0'
+
+export function CronPaneZone() {
+  return (
+    <div className={CRON_PANE_ZONE_CONTENT}>
+      <CronPane />
+    </div>
+  )
+}
