 // writes the store too. Without the opener the boolean went stale the moment
 // anything but the toggle showed the pane — the divergence this whole change
 // is about.
+// Cron rides the same rail as the file browser: the titlebar toggle opens
+// both tabs, and closing either closes the rail. Bound BEFORE files (see the
+// files bind below) so the files unhide fronts LAST when the rail opens —
+// the file tree stays the default active tab, cron waits behind it.
+bindPaneVisibility(
+  'cron',
+  computed([$hasWorkspace, $fileBrowserOpen], (workspace, open) => workspace && open),
+  () => setFileBrowserOpen(false),
+  () => setFileBrowserOpen(true)
+)
 bindPaneVisibility(
